# MongoDB major version / Docker image tag. Linux MongoDB 9 uses 9.0-noble.
MONGO_VERSION=6
MONGO_HOSTNAME=mongo6
HOST_MONGO_PORT=27006
# none: Docker network only; host: 127.0.0.1; lan: 0.0.0.0.
MONGO_PORT_MODE=host
COMPOSE_PROFILES=${MONGO_PORT_MODE}
COMPOSE_FILE=docker-compose.yml
STORE_CREDENTIALS=false
MONGO_LAN_HOST=
# setup.sh gives new installations their own network; existing deployments keep theirs.
MONGO_NETWORK_NAME=mongo_network
MONGO_INITDB_ROOT_USERNAME=root
# setup.sh generates this with openssl rand -hex 32.
MONGO_INITDB_ROOT_PASSWORD=
CONTAINER_NAME=mongo6
COMPOSE_PROJECT_NAME=mongo6
MONGO_LIMIT_CPUS=2
MONGO_LIMIT_MEMORY=4G
MONGO_RESERVATION_CPUS=0.5
MONGO_RESERVATION_MEMORY=200M
